{
	"name": "zeta-edit-prediction",
	"displayName": "Zeta - Edit Prediction",
	"description": "Next Edit Autocomplete using Zeta Model",
	"version": "1.2.8-build.77",
	"publisher": "Yuuzuki",
	"author": {
		"name": "Yuuzuki"
	},
	"contributors": [
		{
			"name": "Yuuzuki"
		},
		{
			"name": "Yuuzuki"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Konno-Yuuzuki/vscode-nes"
	},
	"icon": "assets/zeta.png",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"engines": {
		"vscode": "^1.108.0"
	},
	"categories": [
		"AI",
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"enabledApiProposals": [
		"inlineCompletionsAdditions"
	],
	"contributes": {
		"icons": {
			"zeta-idle": {
				"description": "Zeta idle icon",
				"default": {
					"fontPath": "assets/zeta-icons.woff2",
					"fontCharacter": "\\ea01"
				}
			},
			"zeta-load-1": {
				"description": "Zeta loading frame 1 — |...",
				"default": {
					"fontPath": "assets/zeta-icons.woff2",
					"fontCharacter": "\\ea02"
				}
			},
			"zeta-load-2": {
				"description": "Zeta loading frame 2 — .|..",
				"default": {
					"fontPath": "assets/zeta-icons.woff2",
					"fontCharacter": "\\ea03"
				}
			},
			"zeta-load-3": {
				"description": "Zeta loading frame 3 — ..|.",
				"default": {
					"fontPath": "assets/zeta-icons.woff2",
					"fontCharacter": "\\ea04"
				}
			},
			"zeta-load-4": {
				"description": "Zeta loading frame 4 — ...|",
				"default": {
					"fontPath": "assets/zeta-icons.woff2",
					"fontCharacter": "\\ea05"
				}
			}
		},
		"commands": [
			{
				"command": "zeta.triggerNextEdit",
				"title": "Zeta: Trigger Next Edit Suggestion"
			},
			{
				"command": "zeta.toggleEnabled",
				"title": "Zeta: Toggle Enabled"
			},
			{
				"command": "zeta.showMenu",
				"title": "Zeta: Show Menu"
			},
			{
				"command": "zeta.acceptJumpEdit",
				"title": "Zeta: Accept Jump Edit"
			},
			{
				"command": "zeta.acceptJumpEditLine",
				"title": "Zeta: Accept Jump Edit Line"
			},
			{
				"command": "zeta.acceptInlineEdit",
				"title": "Zeta: Accept Inline Edit"
			},
			{
				"command": "zeta.dismissJumpEdit",
				"title": "Zeta: Dismiss Jump Edit"
			},
			{
				"command": "zeta.enableProposedApi",
				"title": "Zeta: Enable Proposed APIs"
			},
			{
				"command": "zeta.showErrorLog",
				"title": "Zeta: Show Error Log"
			}
		],
		"keybindings": [
			{
				"command": "zeta.acceptJumpEdit",
				"key": "tab",
				"when": "editorTextFocus && zeta.hasJumpEdit && !editorHasSelection"
			},
			{
				"command": "zeta.acceptJumpEditLine",
				"key": "ctrl+enter",
				"when": "editorTextFocus && zeta.hasJumpEdit && !editorHasSelection"
			},
			{
				"command": "zeta.acceptJumpEdit",
				"key": "alt+l",
				"when": "isLinux && editorTextFocus && zeta.hasJumpEdit && !editorHasSelection"
			},
			{
				"command": "zeta.dismissJumpEdit",
				"key": "escape",
				"when": "editorTextFocus && zeta.hasJumpEdit"
			},
			{
				"command": "editor.action.inlineSuggest.hide",
				"key": "escape",
				"when": "editorTextFocus && inlineSuggestionVisible && !zeta.hasJumpEdit"
			},
			{
				"command": "zeta.acceptInlineEditByTab",
				"key": "tab",
				"when": "editorTextFocus && inlineEditVisible && !zeta.hasJumpEdit"
			}
		],
		"configurationDefaults": {
			"editor.inlineSuggest.suppressSuggestions": true
		},
		"configuration": [
			{
				"title": "%zetaConfiguration.server.title%",
				"order": 10,
				"properties": {
					"zeta.serverUrl": {
						"type": "string",
						"default": "http://localhost:8080",
						"order": 10,
						"markdownDescription": "%zeta.serverUrl.description%"
					},
					"zeta.modelName": {
						"type": "string",
						"default": "zeta-edit-prediction",
						"order": 20,
						"markdownDescription": "%zeta.modelName.description%"
					},
					"zeta.temperature": {
						"type": "number",
						"default": 0.2,
						"minimum": 0.0,
						"maximum": 2.0,
						"order": 30,
						"markdownDescription": "%zeta.temperature.description%"
					},
					"zeta.streamEnabled": {
						"type": "boolean",
						"default": false,
						"order": 40,
						"scope": "window",
						"markdownDescription": "%zeta.streamEnabled.description%"
					},
					"zeta.completionTimeoutMs": {
						"type": "number",
						"default": 10000,
						"order": 50,
						"markdownDescription": "%zeta.completionTimeoutMs.description%"
					},
					"zeta.maxTokens": {
						"type": "number",
						"default": 2048,
						"order": 60,
						"minimum": 1,
						"markdownDescription": "%zeta.maxTokens.description%"
					}
				}
			},
			{
				"title": "%zetaConfiguration.behavior.title%",
				"order": 20,
				"properties": {
					"zeta.enabled": {
						"type": "boolean",
						"default": true,
						"order": 10,
						"scope": "window",
						"markdownDescription": "%zeta.enabled.description%"
					},
					"zeta.useCopilotStyleNextEditPresentation": {
						"type": "boolean",
						"default": false,
						"order": 20,
						"scope": "window",
						"markdownDescription": "%zeta.useCopilotStyleNextEditPresentation.description%",
						"tags": [
							"experimental"
						]
					},
					"zeta.autocompleteExclusionPatterns": {
						"type": "array",
						"order": 30,
						"items": {
							"type": "string"
						},
						"default": [
							"**/.env*",
							"**/*.pem",
							"**/*.key",
							"**/*.cert",
							"**/*.crt",
							"**/.dev.vars",
							"**/secrets.yml"
						],
						"markdownDescription": "%zeta.autocompleteExclusionPatterns.description%"
					},
					"zeta.autocompleteSnoozeUntil": {
						"type": "number",
						"default": 0,
						"order": 40,
						"markdownDescription": "%zeta.autocompleteSnoozeUntil.description%"
					},
					"zeta.retriggerOnContextExit": {
						"type": "boolean",
						"default": false,
						"order": 50,
						"markdownDescription": "%zeta.retriggerOnContextExit.description%"
					},
					"zeta.contextExitRetriggerDebounceMs": {
						"type": "number",
						"default": 1500,
						"minimum": 0,
						"order": 55,
						"markdownDescription": "%zeta.contextExitRetriggerDebounceMs.description%"
					},
					"zeta.skipDebounceOnAccept": {
						"type": "boolean",
						"default": true,
						"order": 60,
						"markdownDescription": "%zeta.skipDebounceOnAccept.description%"
					},
					"zeta.suggestionCacheThreshold": {
						"type": "number",
						"default": 3,
						"order": 70,
						"minimum": 1,
						"markdownDescription": "%zeta.suggestionCacheThreshold.description%"
					},
					"zeta.useEditRangeForCache": {
						"type": "boolean",
						"default": true,
						"order": 80,
						"markdownDescription": "%zeta.useEditRangeForCache.description%"
					},
					"zeta.editRangeMargin": {
						"type": "number",
						"default": 3,
						"order": 85,
						"minimum": 0,
						"markdownDescription": "%zeta.editRangeMargin.description%"
					},
					"zeta.reuseIdenticalPromptResults": {
						"type": "boolean",
						"default": false,
						"order": 90,
						"markdownDescription": "%zeta.reuseIdenticalPromptResults.description%"
					},
					"zeta.identicalPromptCacheTtlMs": {
						"type": "number",
						"default": 5000,
						"order": 95,
						"minimum": 0,
						"markdownDescription": "%zeta.identicalPromptCacheTtlMs.description%"
					},
					"zeta.stableRetrievalOrdering": {
						"type": "boolean",
						"default": false,
						"order": 100,
						"markdownDescription": "%zeta.stableRetrievalOrdering.description%"
					}
				}
			},
			{
				"title": "%zetaConfiguration.context.title%",
				"order": 30,
				"properties": {
					"zeta.editableTokens": {
						"type": "number",
						"default": 2500,
						"order": 10,
						"minimum": 1,
						"markdownDescription": "%zeta.editableTokens.description%"
					},
					"zeta.zetaContextTokens": {
						"type": "number",
						"default": 150,
						"order": 20,
						"minimum": 0,
						"markdownDescription": "%zeta.zetaContextTokens.description%"
					},
					"zeta.syntaxAwareExpansion": {
						"type": "boolean",
						"default": true,
						"order": 30,
						"markdownDescription": "%zeta.syntaxAwareExpansion.description%"
					},
					"zeta.maxContextFiles": {
						"type": "number",
						"default": 5,
						"order": 40,
						"minimum": 0,
						"markdownDescription": "%zeta.maxContextFiles.description%"
					},
					"zeta.maxEditHistory": {
						"type": "number",
						"default": 15,
						"order": 50,
						"minimum": 1,
						"markdownDescription": "%zeta.maxEditHistory.description%"
					},
					"zeta.maxRecentChangesChars": {
						"type": "number",
						"default": 12000,
						"order": 60,
						"minimum": 0,
						"markdownDescription": "%zeta.maxRecentChangesChars.description%"
					},
					"zeta.maxClipboardLines": {
						"type": "number",
						"default": 20,
						"order": 70,
						"minimum": 0,
						"markdownDescription": "%zeta.maxClipboardLines.description%"
					},
					"zeta.outlineSymbols": {
						"type": "number",
						"default": 0,
						"order": 80,
						"minimum": 0,
						"markdownDescription": "%zeta.outlineSymbols.description%"
					},
					"zeta.rulesMaxChars": {
						"type": "number",
						"default": 3000,
						"order": 90,
						"markdownDescription": "%zeta.rulesMaxChars.description%"
					},
					"zeta.diagRadius": {
						"type": "number",
						"default": 12,
						"order": 100,
						"markdownDescription": "%zeta.diagRadius.description%"
					}
				}
			},
			{
				"title": "%zetaConfiguration.diagnostics.title%",
				"order": 40,
				"properties": {
					"zeta.injectInlineDiagnostics": {
						"type": "boolean",
						"default": false,
						"order": 10,
						"markdownDescription": "%zeta.injectInlineDiagnostics.description%"
					},
					"zeta.includeDiagnostics": {
						"type": "boolean",
						"default": false,
						"order": 11,
						"markdownDescription": "%zeta.includeDiagnostics.description%"
					},
					"zeta.inlineDiagnosticsMarker": {
						"default": "BUG: LSP error here",
						"order": 20,
						"markdownDescription": "%zeta.inlineDiagnosticsMarker.description%"
					},
					"zeta.diagnosticsMessageTransforms": {
						"type": "object",
						"order": 30,
						"default": {
							"^(.*?) is a magic number;?\\s*consider replacing it with a named constant\\.?$": "replace $1 with a named constant",
							"^Included header (\\S+) is not used directly\\.?$": "remove unused #include of $1",
							"^Variable ['\"`]([^'\"`]+)['\"`] is uninitialized when used here\\.?$": "initialise '$1' before use",
							"^Implicit conversion loses integer precision: ['\"`]([^'\"`]+)['\"`] to ['\"`]([^'\"`]+)['\"`]\\.?$": "narrow $1 to $2 explicitly with a cast"
						},
						"markdownDescription": "%zeta.diagnosticsMessageTransforms.description%",
						"additionalProperties": {
							"type": "string",
							"description": "Replacement string ($1, $2, … for capture groups)"
						}
					}
				}
			}
		]
	},
	"scripts": {
		"build": "bun build src/extension/activate.ts --outfile=out/extension.js --external=vscode --format=cjs --target=node",
		"typecheck": "bun tsgo --noEmit",
		"lint": "bun biome check .",
		"fix": "bun biome check . --write"
	},
	"dependencies": {
		"@shikijs/core": "^3.21.0",
		"@shikijs/engine-javascript": "^3.21.0",
		"@shikijs/langs": "^3.21.0",
		"@shikijs/themes": "^3.21.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@types/bun": "1.3.7",
		"@types/vscode": "1.108.1",
		"@typescript/native-preview": "7.0.0-dev.20260127.1",
		"@vscode/vsce": "^3.9.1",
		"esbuild": "^0.28.0"
	}
}